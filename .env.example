POSTGRES_USER=song_study
POSTGRES_PASSWORD=song_study
POSTGRES_DB=song_study
POSTGRES_PORT=5544

DATABASE_URL=postgresql+psycopg2://song_study:song_study@localhost:5544/song_study

# The database the test suite runs against (dropped and re-created each
# session). Its name must end in _test and differ from DATABASE_URL's.
TEST_DATABASE_URL=postgresql+psycopg2://song_study:song_study@localhost:5544/song_study_test

# Comma-separated list of origins the backend's CORS policy allows.
# Defaults to http://localhost:5173 (the Vite dev server) if unset.
ALLOWED_ORIGINS=http://localhost:5173

# Google login: an OAuth client (type "Web application") from the Google
# Cloud console, with http://localhost:8000/auth/callback as an authorized
# redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs the session cookie; without it, everyone is logged out on each
# backend restart. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# Where the callback sends the browser after logging in.
FRONTEND_URL=http://localhost:5173
# Set to 1 when the backend is served over https.
HTTPS_ONLY_COOKIES=
