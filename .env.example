POSTGRES_USER=song_study
POSTGRES_PASSWORD=song_study
POSTGRES_DB=song_study
POSTGRES_PORT=5544

DATABASE_URL=postgresql+psycopg2://song_study:song_study@localhost:5544/song_study

# The database the test suite runs against (dropped and re-created each
# session). Its name must end in _test and differ from DATABASE_URL's.
TEST_DATABASE_URL=postgresql+psycopg2://song_study:song_study@localhost:5544/song_study_test

# Google login: an OAuth client (type "Web application") from the Google
# Cloud console, with <APP_URL>/api/auth/callback (http://localhost:5173/api/auth/callback
# locally) as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs the session cookie; without it, everyone is logged out on each
# backend restart. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# Where the app is reached in a browser. The API is served under /api on this
# same origin (the Vite dev server proxies it locally; a reverse proxy does
# the same when deployed). The session cookie is Secure iff this is https.
APP_URL=http://localhost:5173

# Deployment (docker-compose.prod.yml), in a separate .env on the server:
#   APP_URL=https://<domain>
#   DATABASE_URL=postgresql+psycopg2://<user>:<password>@postgres:5432/<db>
#     (host is the compose service name; the password matches POSTGRES_PASSWORD)
#   SESSION_SECRET=<a real one>
# TEST_DATABASE_URL and POSTGRES_PORT are not used there.
